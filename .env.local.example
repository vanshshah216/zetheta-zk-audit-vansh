# Supabase (required for database features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required in production — session cookie signing (min 32 random bytes)
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=your-random-secret-here

# Protect the /api/seed endpoint (required if you enable seeding in production)
# Generate with: openssl rand -hex 32
SEED_SECRET=your-random-secret-here

# NODE_ENV is set to "production" automatically on Vercel
